// Hypertron core — Freighter identity + merchant payment links (non-custodial)
//
// OWNERSHIP: This schema is the sole owner of Business, PaymentLink, and
// AuthChallenge. hypertron-api must not prisma db push against these collections.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// One-time Freighter SEP-53 login challenges.
model AuthChallenge {
  id            String   @id @default(cuid()) @map("_id")
  walletAddress String
  message       String // exact UTF-8 string the wallet must sign
  expiresAt     DateTime
  used          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([walletAddress, used])
  @@index([expiresAt])
}

model Business {
  id                   String    @id @default(cuid()) @map("_id")
  // Legacy owner/payment fallback address. Workspace access is owned by BusinessMember.
  walletAddress        String // Stellar G... Freighter login identity
  receiveAddress       String? // Stellar G... / C... where this business receives payments
  /// Public viewing key for private notes; viewSecret never leaves the browser.
  viewPub              String?
  /// Public spend key (owner_pk); spendSecret never leaves the browser.
  spendPub             String?
  name                 String?
  email                String?
  businessNature       String?
  selectedWidgets      String[]
  selectedTier         String?
  selectedTierName     String?
  selectedTierAt       DateTime?
  complianceForm       Json?
  workspaceType        String?
  website              String?
  teamSize             String?
  logoDataUrl          String?
  logoName             String?
  operationModules     String[]
  walletProvider       String?
  supportedChains      String[]
  invitedMembers       Json?
  integrations         String[]
  complianceFrameworks String[]
  complianceMonitoring String[]
  dataResidency        String?
  dataRetention        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  paymentLinks PaymentLink[]
  members      BusinessMember[]

  @@index(walletAddress)
  @@index(selectedTier)
}

// Wallet-based access to a Business workspace. This keeps businessId as the
// isolation key used by payment links and the payments API.
model BusinessMember {
  id             String   @id @default(cuid()) @map("_id")
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  walletAddress  String
  role           String   @default("owner")
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([walletAddress, businessId])
  @@index([walletAddress, lastAccessedAt])
  @@index(businessId)
}

// Active workspace is persisted server-side so old session cookies remain
// valid and cross-origin cookie behavior does not change.
model WalletPreference {
  id               String   @id @default(cuid()) @map("_id")
  walletAddress    String   @unique
  activeBusinessId String?
  updatedAt        DateTime @updatedAt
}

model PaymentLink {
  id                 String    @id @default(cuid()) @map("_id")
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount             String? // null = pay any amount (flexible)
  currency           String    @default("USDC") // USDC | XLM
  purpose            String?
  clientName         String?
  workflowStage      String?
  /// Merchant-authored content + privateSettlement flag — not shield crypto.
  metadata           String?
  paymentMethods     String[]  @default(["wallet", "qr"])
  expiresAt          DateTime?
  linkMemo           String    @unique
  destinationAddress String
  /// Merchant derives n,k from (viewSecret, salt) — store explicitly, not in metadata.
  shieldSalt         String?
  /// 32-byte hex note commitment the customer funds.
  shieldCommitment   String?
  /// ~384-byte Groth16 proof hex (~768 chars).
  shieldProof        String?
  paidAt             DateTime?
  paymentTxHash      String?
  /// When payer submitted a private transfer claiming this link.
  claimedAt          DateTime?
  /// Transfer tx hash from payer.
  claimTxHash        String?
  /// The out_cm1 (recipient note commitment) from the transfer.
  claimOutCommitment String?
  /// Merchant confirmed decrypting the note (final state).
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index(businessId)
  @@index([businessId, paidAt])
}
