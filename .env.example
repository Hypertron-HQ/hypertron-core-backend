# Nest API server
PORT=4000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# MongoDB connection string used by Prisma
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER/hypertron?retryWrites=true&w=majority"

# Use a long, random secret in every environment. It signs dashboard session cookies.
AUTH_SECRET=replace-with-a-long-random-secret

# Payment-link settlement destination. A workspace vault takes precedence when configured.
PAYMENT_POOL_ADDRESS=
MERCHANT_RECIPIENT=

# Required only when using Privy sign-in and embedded Stellar wallets.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
