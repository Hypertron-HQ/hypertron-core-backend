# Nest API server
PORT=4000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# MongoDB — core_svc user (NOT shared admin). Owns Business, PaymentLink, AuthChallenge.
# See ../scripts/atlas-mongo-users.md
DATABASE_URL="mongodb+srv://core_svc:PASSWORD@CLUSTER/hypertron?retryWrites=true&w=majority"

# Use a long, random secret in every environment. It signs dashboard session cookies.
AUTH_SECRET=replace-with-a-long-random-secret

# Payment-link settlement destination (pool contract or merchant receive fallback).
PAYMENT_POOL_ADDRESS=
MERCHANT_RECIPIENT=

# Collect PaymentLink Horizon reconciler (ported from hypertron-api)
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org
STELLAR_RECONCILER_LOOKBACK=50
STELLAR_USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3MNLQUIL
STELLAR_USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
DISABLE_RECONCILER=false

# Non-blocking MerchantSettings push to hypertron-api (A4)
PAYMENTS_API_URL=http://localhost:4001
INTERNAL_SERVICE_TOKEN=replace-with-long-random-token
