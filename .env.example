# =============================================================================
# Hypertron Core Backend — environment template
# Copy to .env for local use. Never commit real secrets.
# =============================================================================

# --- Required ---
# MongoDB connection string used by Prisma (MongoDB provider; no SQL migrations).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER/hypertron?retryWrites=true&w=majority"

# HMAC secret for ht_dashboard session cookies. Use a long random value per environment.
# Must match hypertron-api AUTH_SECRET if both services share dashboard cookies.
AUTH_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed for credentialed CORS (dashboard + checkout).
CORS_ORIGIN=http://localhost:3000

# Public frontend origin used when building payment-link URLs.
FRONTEND_URL=http://localhost:3000

# --- Optional ---
# Local default. Render injects PORT; do not hardcode it in the Render dashboard for Docker.
PORT=4000

# Fallback for FRONTEND_URL if FRONTEND_URL is unset.
# APP_URL=http://localhost:3000

# Default pool / contract destination when a workspace vault is not set.
PAYMENT_POOL_ADDRESS=

# Legacy alias read if PAYMENT_POOL_ADDRESS is empty.
# NEXT_PUBLIC_PAYMENT_POOL_ADDRESS=

# Classic G-address fallback when no pool address is configured.
MERCHANT_RECIPIENT=

# Cookie SameSite. Production defaults to "none" (Vercel frontend + Render API).
# Set COOKIE_SAMESITE=lax only if the dashboard is same-site as this API.
# COOKIE_SAMESITE=none

# --- Service account (tests + hypertron-api → core-backend) ---
# Secret. Generate: node -e "console.log('ht_svc_'+require('crypto').randomBytes(32).toString('hex'))"
SERVICE_ACCOUNT_API_KEY=ht_svc_replace-with-a-long-random-hex
# Stellar G-address this service account acts as (Business is auto-created).
SERVICE_ACCOUNT_WALLET=GSVCACCOUNTTESTNET00000000000000000000000000000000000000

# Optional: core → hypertron-api merchant sync
# PAYMENTS_API_URL=https://your-hypertron-api.onrender.com
# INTERNAL_SERVICE_TOKEN=replace-with-shared-internal-token

# --- Secrets (required in every deployed environment; placeholders only) ---
# DATABASE_URL and AUTH_SECRET above.

# --- Render-specific ---
# Set automatically by Render. Do not invent values.
# PORT          assigned at runtime; app listens on 0.0.0.0:$PORT
# NODE_ENV      set to production on the service
NODE_ENV=development
